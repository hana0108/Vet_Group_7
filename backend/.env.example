# Configuracion de MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=vetgroup7_demo_nueva

# Nombre de una base NUEVA para la instalacion inicial
# No debe contener tablas existentes
DB_SETUP_NAME=vetgroup7_demo_nueva

# Servidor
PORT=3000

# Cambiar por una clave privada y aleatoria en cada instalacion
SESSION_SECRET=REEMPLAZAR_POR_UNA_CLAVE_SEGURA

# Origenes autorizados para el frontend
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
